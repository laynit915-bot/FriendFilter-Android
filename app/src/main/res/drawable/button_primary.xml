<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#6D28D9" android:endColor="#0877E8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#A855F7" android:centerColor="#7C3AED" android:endColor="#0A8CFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
