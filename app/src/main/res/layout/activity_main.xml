<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
  <LinearLayout android:id="@+id/dashboard" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="FriendFilter" android:textStyle="bold" android:textSize="30sp" android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Dọn danh sách bạn bè • xử lý trên thiết bị" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:background="@drawable/card" android:orientation="vertical" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:text="Tình trạng" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      <TextView android:id="@+id/status" android:text="Sẵn sàng đăng nhập Facebook" android:textColor="@color/muted" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
      <TextView android:id="@+id/stats" android:text="Đã ghi nhận: 0 hồ sơ" android:textStyle="bold" android:textColor="@color/brandDark" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button android:id="@+id/loginBtn" android:text="ĐĂNG NHẬP / MỞ FACEBOOK" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
    <Button android:id="@+id/friendsBtn" android:text="MỞ DANH SÁCH BẠN BÈ" android:layout_marginTop="9dp" android:layout_width="match_parent" android:layout_height="54dp"/>
    <Button android:id="@+id/resultsBtn" android:text="XEM KẾT QUẢ ĐÃ GHI NHẬN" android:layout_marginTop="9dp" android:layout_width="match_parent" android:layout_height="54dp"/>
    <LinearLayout android:background="@drawable/card" android:orientation="vertical" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:text="An toàn mặc định" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      <TextView android:text="Session Facebook nằm trong WebView trên máy. Không gửi cookie/token sang server của FriendFilter. Không tự động hủy kết bạn. Hồ sơ thiếu dữ liệu được giữ ở trạng thái Chưa xác định." android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:text="Trong màn hình Facebook: cuộn danh sách để tải thêm bạn, sau đó bấm Ghi nhận trang." android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/browserPanel" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <Button android:id="@+id/backBtn" android:text="← APP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
      <Button android:id="@+id/scanBtn" android:text="GHI NHẬN TRANG" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="2" android:layout_height="48dp"/>
    </LinearLayout>
    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
</LinearLayout>
